{
  "name": "artifact-drawer",
  "publisher": "aem2create",
  "displayName": "Artifact Drawer",
  "description": "A tool for viewing and integrating code artifacts from a library.",
  "version": "0.0.2",
  "icon": "images/icon.png",
  "repository": "github.com:AlexEMagee/vscode-artifact-drawer",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Artifact Drawer Settings",
      "properties": {
        "artifact-drawer.db-file": {
          "type": "string",
          "default": "",
          "description": "The file to use for artifacts."
        }
      }
    },
    "commands": [
      {
        "command": "artifact-drawer.importArtifact",
        "title": "Import Artifact",
        "icon": "$(terminal-new)"
      },
      {
        "command": "artifact-drawer.loadArtifactLibrary",
        "title": "Load Artifact Library",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "artifact-drawer.loadArtifactLibrary",
          "when": "view == artifacts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "artifact-drawer.importArtifact",
          "when": "view == artifacts && viewItem == artifact",
          "group": "inline"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "artifacts",
          "name": "Artifacts",
          "icon": "images/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.146.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "artifact-package": "github:AlexEMagee/artifact-package",
    "vscode-extension-utilities": "github:AlexEMagee/vscode-extension-utilities"
  }
}
